# Secret Key & Debug
SECRET_KEY=django-insecure-cubixskill-production-backend-secret-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=*

# Database (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=cubixskill_db
DB_USER=cubixskill_user
DB_PASSWORD=cubixskill_pass
DB_HOST=localhost
DB_PORT=5432

# Object Storage (MinIO / S3)
STORAGE_BACKEND=minio
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_EXTERNAL_ENDPOINT_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_STORAGE_BUCKET_NAME=cubixskill-media
MINIO_REGION_NAME=us-east-1
MINIO_USE_SSL=False

# Celery & Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Payment Gateway Configuration (Provider-Agnostic)
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_PUBLISHABLE_KEY=pk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=USD

# Email Configuration (App Password)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_digit_app_password
DEFAULT_FROM_EMAIL=noreply@cubixskill.com

