# Secret Key & Debug Configuration
SECRET_KEY=your-production-secret-key-here
DEBUG=False
ALLOWED_HOSTS=app.cubixskill.com,api.cubixskill.com

# Database (PostgreSQL / DATABASE_URL)
# DATABASE_URL=postgres://user:password@localhost:5432/cubixskill_db
DB_ENGINE=django.db.backends.postgresql
DB_NAME=cubixskill_db
DB_USER=cubixskill_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# CORS & CSRF Trusted Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=https://app.cubixskill.com,https://student.cubixskill.com
CSRF_TRUSTED_ORIGINS=https://app.cubixskill.com,https://student.cubixskill.com

# Cookie & HTTPS Security Settings
AUTH_COOKIE_SECURE=True
AUTH_COOKIE_SAMESITE=Lax
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
USE_SECURE_PROXY_HEADER=False

# Object Storage (MinIO / S3)
STORAGE_BACKEND=s3
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_EXTERNAL_ENDPOINT_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_STORAGE_BUCKET_NAME=cubixskill-media
MINIO_REGION_NAME=us-east-1
MINIO_USE_SSL=False

# Celery & Redis Task Queue
REDIS_URL=redis://localhost:6379/0
USE_REDIS_CHANNELS=True
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Payment Gateway Configuration (Razorpay)
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_CURRENCY=INR

# Email Configuration (SMTP Backend)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@cubixskill.com
EMAIL_HOST_PASSWORD=your_smtp_password
DEFAULT_FROM_EMAIL=noreply@cubixskill.com

# Frontend Portal URLs
FRONTEND_ACADEMY_URL=https://instructor.cubixskill.com
STUDENT_PUBLIC_URL=https://student.cubixskill.com
