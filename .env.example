# CubixSkill backend configuration template.
# Copy to .env and replace placeholders. Never commit .env or real credentials.
# For localhost development follow docs/environment-configuration.md.

# Django
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY
DEBUG=False
ALLOWED_HOSTS=api.cubixskill.com

# PostgreSQL: use ONE connection method.
# Preferred managed database URL (uncomment and set in production):
# DATABASE_URL=postgresql://user:password@db-host:5432/cubixskill_db
# Alternative individual database variables (when DATABASE_URL is absent):
USE_POSTGRES=True
DB_ENGINE=django.db.backends.postgresql
DB_NAME=cubixskill_db
DB_USER=cubixskill_user
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD
DB_HOST=localhost
DB_PORT=5432

# Exact browser origins: instructor, student, and marketing/public website.
# No wildcard with credentials, no trailing path or slash.
# Local port 5175 must be included when explicitly setting this variable.
CORS_ALLOWED_ORIGINS=https://instructor.cubixskill.com,https://student.cubixskill.com,https://cubixskill.com
CSRF_TRUSTED_ORIGINS=https://instructor.cubixskill.com,https://student.cubixskill.com,https://cubixskill.com

# Cookies. Same-site subdomains can use Lax.
# Cross-site frontends may need SameSite=None + Secure=True + HTTPS,
# subject to browser third-party-cookie restrictions.
AUTH_COOKIE_SECURE=True
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_PATH=/
AUTH_COOKIE_DOMAIN=
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7

# Reverse proxy / HTTPS. Only enable proxy-header trust behind a trusted proxy.
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
USE_SECURE_PROXY_HEADER=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Redis / Channels / Celery
REDIS_URL=redis://localhost:6379/0
USE_REDIS_CHANNELS=True
# When omitted, broker and result backend default to REDIS_URL:
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_TIME_LIMIT_SECONDS=1800
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_BROKER_CONNECTION_MAX_RETRIES=3
CELERY_RESULT_BACKEND_MAX_RETRIES=3
CELERY_RESULT_EXPIRES_SECONDS=86400
STORAGE_BILLING_BEAT_INTERVAL_SECONDS=60

# Storage / MinIO (configure real private production credentials)
STORAGE_BACKEND=s3
MINIO_ENDPOINT_URL=https://objects.example.com
MINIO_EXTERNAL_ENDPOINT_URL=https://objects.example.com
MINIO_ACCESS_KEY=REPLACE_WITH_STORAGE_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_STORAGE_SECRET_KEY
MINIO_STORAGE_BUCKET_NAME=cubixskill-media
MINIO_REGION_NAME=us-east-1
MINIO_USE_SSL=True

# Razorpay
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=REPLACE_WITH_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_RAZORPAY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET
RAZORPAY_CURRENCY=INR

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@cubixskill.com
EMAIL_HOST_PASSWORD=REPLACE_WITH_EMAIL_PASSWORD
DEFAULT_FROM_EMAIL=noreply@cubixskill.com

# Public-facing instructor/student portal URLs
FRONTEND_ACADEMY_URL=https://instructor.cubixskill.com
STUDENT_PUBLIC_URL=https://student.cubixskill.com

# Internationalization
LANGUAGE_CODE=en-us
TIME_ZONE=Asia/Kolkata
